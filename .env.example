# Resend API for contact form
# Get your API key from: https://resend.com/api-keys
# For testing, use a key starting with 're_test_'
RESEND_API_KEY=re_your_api_key_here

# Contact form email addresses
# CONTACT_EMAIL: where form submissions are delivered (required)
CONTACT_EMAIL=you@example.com
# FROM_EMAIL: the sender address shown in the email (optional, has default)
# FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Site URL (used for meta tags and canonical URLs)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Upstash Redis for persistent rate limiting (optional)
# Without these, the app falls back to in-memory rate limiting
# (works fine locally but resets on serverless cold starts).
# Get credentials from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
